    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.15.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3",
    "@eslint/eslintrc": "3.3.7",
    "fake-indexeddb": "6.2.7",
    "wrangler": "4.156.0"
