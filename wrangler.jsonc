{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serpix",
  "main": "worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "serpix-production",
      "database_id": "f0ff89b6-5cb3-41f7-8fa8-37e3a94621ad",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "106402432160-i1q0lfebt170j48q29gtdn3irlk82j3u.apps.googleusercontent.com",
    // Web Push (public VAPID key is public by design; the private one is the VAPID_PRIVATE_KEY secret).
    "VAPID_PUBLIC_KEY": "BFUYqMDu8-xW7U64g_TaoIRf-dxjWybTTuIW0F4H-44QLVecap-EcYKwVQkYQ6n-U2DOtevfT4Fsdg1rWrf541o",
    // Cuentix pushes business movements only into this account (must be admin and approved).
    "CUENTIX_SYNC_OWNER_EMAIL": "lucianoolivabianco@gmail.com",
    // Mailtox reads and upserts contacts only for this account (must be admin and approved). Same owner as CUENTIX_SYNC_OWNER_EMAIL.
    "MAILTOX_LINK_OWNER_EMAIL": "lucianoolivabianco@gmail.com",
    // lulox-mcp calls the McpRpc entrypoint only for this account (must be admin and approved).
    "MCP_OWNER_EMAIL": "lucianoolivabianco@gmail.com",
    // Secrets (wrangler secret put, never here): BETTER_AUTH_SECRET, GOOGLE_CLIENT_SECRET, PORTFOLIO_INBOUND_SECRET, VAPID_PRIVATE_KEY, CUENTIX_SYNC_SECRET, LUMA_ICS_URL, LUMA_SETTINGS_KEY
  },
  // Workers AI (receipt reading). Free tier: 10,000 neurons/day; model in lib/receipt.ts.
  "ai": { "binding": "AI" },
  // "0 12 * * *" daily at 12:00 UTC = 09:00 America/Buenos_Aires: overdue-invoice push, due recurring movements, unattached-receipt purge, and the Luma sync.
  // "30 */6 * * *" runs only the Luma sync. The saved link (LUMA_SETTINGS_KEY) wins over the LUMA_ICS_URL secret; if both are missing the sync logs luma_sync_skipped.
  "triggers": { "crons": ["0 12 * * *", "30 */6 * * *"] },
  "observability": { "enabled": true }
}
