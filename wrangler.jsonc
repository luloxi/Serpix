{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serpix",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "serpix-production",
      "database_id": "f0ff89b6-5cb3-41f7-8fa8-37e3a94621ad",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {\n    "GOOGLE_CLIENT_ID": "106402432160-i1q0lfebt170j48q29gtdn3irlk82j3u.apps.googleusercontent.com"\n  },\n  "observability": { "enabled": true }
}
