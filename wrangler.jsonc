{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serpix",
  "main": "worker.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "serpix-production",
      "database_id": "f0ff89b6-5cb3-41f7-8fa8-37e3a94621ad",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "106402432160-i1q0lfebt170j48q29gtdn3irlk82j3u.apps.googleusercontent.com",
    // Web Push (public VAPID key is public by design; the private one is the VAPID_PRIVATE_KEY secret).
    "VAPID_PUBLIC_KEY": "BFUYqMDu8-xW7U64g_TaoIRf-dxjWybTTuIW0F4H-44QLVecap-EcYKwVQkYQ6n-U2DOtevfT4Fsdg1rWrf541o",
    // Secrets (wrangler secret put, never here): BETTER_AUTH_SECRET, GOOGLE_CLIENT_SECRET, PORTFOLIO_INBOUND_SECRET, VAPID_PRIVATE_KEY
  },
  // Daily overdue-invoice push (free Cron Trigger): 12:00 UTC = 09:00 America/Buenos_Aires.
  "triggers": { "crons": ["0 12 * * *"] },
  "observability": { "enabled": true }
}
